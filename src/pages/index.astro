---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import FilterControls from '../components/FilterControls.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    {/* Filter Controls */}
    <div class="mb-8">
      <FilterControls {categories} {publishers} />
    </div>

    {/* Games Grid */}
    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div
            id="games-grid"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
            data-testid="games-grid"
            role="region"
            aria-label="Filtered games list"
          >
            {games.map((game) => (
              <div
                data-game-id={game.id}
                data-category-id={game.category?.id}
                data-publisher-id={game.publisher?.id}
                data-testid={`game-card-${game.id}`}
              >
                <GameCard {game} />
              </div>
            ))}
          </div>

          {/* No Results Message */}
          <div
            id="no-results-message"
            class="hidden text-center py-12"
            data-testid="no-results-message"
            role="status"
            aria-live="polite"
          >
            <p class="text-slate-300 text-lg">No games match your filters.</p>
            <button
              class="mt-4 px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-100 rounded-md transition-colors duration-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              onclick="document.getElementById('game-filters').reset(); filterGames();"
              data-testid="reset-filters-button"
              aria-label="Reset all filters"
            >
              Reset Filters
            </button>
          </div>

          <nav
            class="mt-8 flex items-center justify-between gap-4"
            aria-label="Game list pagination"
            data-testid="pagination"
          >
            <button
              type="button"
              id="previous-page"
              class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-100 rounded-md transition-colors duration-200 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
              data-testid="previous-page-button"
              aria-label="Go to previous page"
            >
              Previous
            </button>
            <span
              id="pagination-status"
              class="text-slate-300 text-sm"
              data-testid="pagination-status"
              aria-live="polite"
            ></span>
            <button
              type="button"
              id="next-page"
              class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-100 rounded-md transition-colors duration-200 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
              data-testid="next-page-button"
              aria-label="Go to next page"
            >
              Next
            </button>
          </nav>
        </>
      )}
    </div>
  </div>

  {/* Client-side filtering script */}
  <script>
    const gamesPerPage = 6;
    let currentPage = 1;

    function filterGames() {
      // Get filter form values
      const form = document.getElementById('game-filters') as HTMLFormElement;
      if (!form) return;

      const selectedCategories = Array.from(form.querySelectorAll('input[name="categories"]:checked'))
        .map((input) => Number((input as HTMLInputElement).value));
      const selectedPublisher = (form.elements.namedItem('publisher') as HTMLSelectElement)?.value || '';

      // Get all game cards. Scoped to direct children of the grid, since
      // GameCard's own inner anchor also carries a data-game-id attribute and
      // would otherwise be double-counted by an unscoped '[data-game-id]' selector.
      const gameCards = document.querySelectorAll('#games-grid > [data-game-id]');
      let filteredCount = 0;

      gameCards.forEach((card) => {
        const categoryId = card.getAttribute('data-category-id');
        const publisherId = card.getAttribute('data-publisher-id');

        let isVisible = true;

        // Apply category filter (OR logic - show if any selected category matches)
        if (selectedCategories.length > 0) {
          isVisible = isVisible && selectedCategories.includes(Number(categoryId));
        }

        // Apply publisher filter (AND logic - must match if selected)
        if (selectedPublisher !== '') {
          isVisible = isVisible && publisherId === selectedPublisher;
        }

        const parent = card as HTMLElement;
        if (isVisible) {
          filteredCount++;
        } else {
          parent.style.display = 'none';
        }
      });

      const totalPages = Math.max(1, Math.ceil(filteredCount / gamesPerPage));
      currentPage = Math.min(currentPage, totalPages);
      let visibleCount = 0;
      let filteredIndex = 0;
      gameCards.forEach((card) => {
        const parent = card as HTMLElement;
        const categoryId = card.getAttribute('data-category-id');
        const publisherId = card.getAttribute('data-publisher-id');
        const matchesFilters =
          (selectedCategories.length === 0 || selectedCategories.includes(Number(categoryId))) &&
          (selectedPublisher === '' || publisherId === selectedPublisher);

        if (matchesFilters && filteredIndex >= (currentPage - 1) * gamesPerPage && filteredIndex < currentPage * gamesPerPage) {
          parent.style.display = '';
          visibleCount++;
        } else {
          parent.style.display = 'none';
        }
        if (matchesFilters) filteredIndex++;
      });

      // Show/hide no results message
      const noResultsMessage = document.getElementById('no-results-message') as HTMLElement;
      const gamesGrid = document.getElementById('games-grid') as HTMLElement;
      if (noResultsMessage && gamesGrid) {
        if (filteredCount === 0 && (selectedCategories.length > 0 || selectedPublisher !== '')) {
          noResultsMessage.classList.remove('hidden');
          gamesGrid.setAttribute('aria-busy', 'false');
        } else {
          noResultsMessage.classList.add('hidden');
          gamesGrid.setAttribute('aria-busy', 'false');
        }
      }

      // Update ARIA live region to announce filter results
      if (gamesGrid) {
        const ariaLiveMessage = `Showing ${visibleCount} of ${filteredCount} ${filteredCount === 1 ? 'game' : 'games'}`;
        (gamesGrid as HTMLElement).setAttribute('data-result-count', ariaLiveMessage);
      }

      const previousButton = document.getElementById('previous-page') as HTMLButtonElement;
      const nextButton = document.getElementById('next-page') as HTMLButtonElement;
      const paginationStatus = document.getElementById('pagination-status');
      if (previousButton && nextButton && paginationStatus) {
        previousButton.disabled = currentPage === 1;
        nextButton.disabled = currentPage === totalPages;
        paginationStatus.textContent = `Page ${currentPage} of ${totalPages}`;
      }
    }

    // Initialize immediately
    function initializeFilters() {
      const form = document.getElementById('game-filters') as HTMLFormElement;
      if (!form) return;

      // Listen to category checkbox changes using event delegation
      form.addEventListener('change', (event) => {
        const target = event.target as HTMLInputElement | HTMLSelectElement;
        if (target && (target.name === 'categories' || target.name === 'publisher')) {
          currentPage = 1;
          filterGames();
        }
      });
      form.addEventListener('reset', () => {
        currentPage = 1;
        requestAnimationFrame(filterGames);
      });

      document.getElementById('previous-page')?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          filterGames();
        }
      });
      document.getElementById('next-page')?.addEventListener('click', () => {
        currentPage++;
        filterGames();
      });

      // Initialize filter state
      filterGames();
    }

    // Try to initialize immediately (for when script runs after DOM is ready)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeFilters);
    } else {
      initializeFilters();
    }
  </script>
</Layout>
